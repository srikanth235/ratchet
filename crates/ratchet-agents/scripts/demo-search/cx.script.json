    {
      "name": "1. memoize parseFilter",
      "steps": [
        {
          "type": "message",
          "text": "The filter parser rebuilds RegExps per character and parses twice per request; start with the cheap win: memoize by expression text."
        },
        {
          "type": "tool",
          "name": "Bash",
          "input": {
            "command": "node --cpu-prof dist/src/main.js"
          },
          "output": "CPU profile written",
          "ms": 3000
        },
        {
          "type": "patch",
          "name": "memoize parseFilter",
          "file": "03-filter-memoize-parse.patch",
          "skip": {
            "file": "src/filter.ts",
            "contains": "parseCache",
            "skipWhen": "present"
          }
        },
        {
          "type": "tool",
          "name": "Bash",
          "input": {
            "command": "pnpm test"
          },
          "output": "Tests  65 passed (65)",
          "ms": 4000
        },
        {
          "type": "tool",
          "name": "Bash",
          "input": {
            "command": "pnpm build && node dist/bench/local.js --duration 20 --out /tmp/r.json"
          },
          "output": "p95 measured",
          "ms": 6000
        },
        {
          "type": "message",
          "text": "parseFilter memoized; unit and contract tests pass."
        },
        {
          "type": "usage",
          "inputTokens": 68608,
          "outputTokens": 3920
        }
      ]
