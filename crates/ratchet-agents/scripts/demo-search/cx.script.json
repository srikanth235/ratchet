        {
          "type": "message",
          "text": "Deep clone gone; hits are built lazily for the returned page."
        },
        {
          "type": "usage",
          "inputTokens": 82944,
          "outputTokens": 4310
        }
      ]
    },
    {
      "name": "contract-breaking tweak (tag weight)",
      "steps": [
        {
          "type": "message",
          "text": "Tag matches are rarely what users want first; zeroing their weight skips a branch of work in scoring and lets ties fall through to rating."
        },
        {
          "type": "edit",
          "path": "src/search.ts",
          "find": "const TAG_WEIGHT = 1;",
          "replace": "const TAG_WEIGHT = 0;"
        },
        {
          "type": "tool",
          "name": "Bash",
          "input": {
            "command": "pnpm test"
          },
          "output": "Tests  65 passed (65)",
          "ms": 3000
        },
        {
          "type": "tool",
          "name": "Bash",
          "input": {
            "command": "pnpm build && node dist/bench/local.js --duration 20 --out /tmp/r.json"
