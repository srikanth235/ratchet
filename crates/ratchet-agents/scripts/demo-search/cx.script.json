          "file": "01-search-no-deep-clone.patch",
          "skip": {
            "file": "src/search.ts",
            "contains": "JSON.parse(JSON.stringify",
            "skipWhen": "absent"
          }
        },
        {
          "type": "tool",
          "name": "Bash",
          "input": {
            "command": "pnpm test"
          },
          "output": "Tests  65 passed (65)",
