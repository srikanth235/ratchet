+/**
+ * Terminal width and color count, from the environment the terminal already provides: `COLUMNS`, else the width
+ * of the tty, else 80; 256 colors for a `*-256color` TERM, else 8.
+ */
+export function detectTerminal(env: NodeJS.ProcessEnv = process.env): Terminal {
+  const fromEnv = Number(env.COLUMNS);
+  const columns = Number.isInteger(fromEnv) && fromEnv > 0 ? fromEnv : process.stdout.columns > 0 ? process.stdout.columns : 80;
+  return { columns, colors: /-256color$/.test(env.TERM ?? '') ? 256 : 8 };
 }
