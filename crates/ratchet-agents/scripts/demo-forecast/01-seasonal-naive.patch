 import { mean, tail, type Series } from './features.js';
@@ -4,6 +4,9 @@ import { mean, tail, type Series } from './features.js';
 export const WINDOW = 4;
+export const SEASON = 52;
+/** Weeks over which this year's level is compared with last year's. */
+const RATIO_WINDOW = 8;
 
 export interface Model {
-  /** Per SKU. */
-  level: number[];
+  /** Per SKU: sales history. */
+  history: number[][];
 }
@@ -11,3 +14,11 @@ export interface Model {
 export function fit(series: readonly Series[]): Model {
-  return { level: series.map((s) => mean(tail(s.y, WINDOW))) };
+  return { history: series.map((s) => s.y) };
+}
+
+function seasonalNaive(y: readonly number[], horizon: number): number[] {
+  const n = y.length;
+  if (n < SEASON + RATIO_WINDOW) return new Array<number>(horizon).fill(mean(tail(y, WINDOW)));
+  const lastYear = mean(y.slice(n - SEASON - RATIO_WINDOW, n - SEASON));
+  const ratio = Math.min(2, Math.max(0.5, mean(tail(y, RATIO_WINDOW)) / Math.max(1e-6, lastYear)));
+  return Array.from({ length: horizon }, (_, h) => y[n - SEASON + (h % SEASON)]! * ratio);
 }
