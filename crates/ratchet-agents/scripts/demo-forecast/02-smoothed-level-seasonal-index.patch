+/** Mean index of each week of the year over all full years before the origin, normalised to mean 1. */
+function seasonalProfile(y: readonly number[]): number[] {
+  const n = y.length;
+  const years = Math.floor(n / SEASON);
+  if (years < 1) return new Array<number>(SEASON).fill(1);
+  const raw = new Array<number>(SEASON).fill(0);
+  for (let k = 1; k <= years; k++) {
+    const block = y.slice(n - k * SEASON, n - (k - 1) * SEASON);
+    const yearLevel = Math.max(1e-6, mean(block));
+    block.forEach((v, j) => (raw[j]! += v / yearLevel / years));
+  }
+  const w = PROFILE_SMOOTHING;
+  const smooth = raw.map((v, j) => (1 - 2 * w) * v + w * raw[(j + SEASON - 1) % SEASON]! + w * raw[(j + 1) % SEASON]!);
+  const norm = mean(smooth);
+  if (!(norm > 0)) return new Array<number>(SEASON).fill(1); // a SKU that never sold has no seasonality to learn
+  return smooth.map((v) => Math.max(0.1, v / norm));
 }
 
