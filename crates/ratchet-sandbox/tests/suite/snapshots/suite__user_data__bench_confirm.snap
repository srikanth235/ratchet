---
source: crates/ratchet-sandbox/tests/suite/user_data.rs
expression: "bench_user_data(&bench(BenchPurpose::Confirm), 2.0).unwrap()"
---
#!/bin/bash
set -euo pipefail
shutdown -h +120 >/dev/null 2>&1 || true
id -u ratchet-bench >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin ratchet-bench
id -u ratchet-holdout >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin ratchet-holdout
iptables -I OUTPUT 1 -m owner --uid-owner ratchet-bench -d 169.254.169.254 -j REJECT
iptables -I OUTPUT 1 -m owner --uid-owner ratchet-holdout -d 169.254.169.254 -j REJECT
command -v ip6tables >/dev/null 2>&1 && ip6tables -I OUTPUT 1 -m owner --uid-owner ratchet-bench -d fd00:ec2::254 -j REJECT || true
command -v ip6tables >/dev/null 2>&1 && ip6tables -I OUTPUT 1 -m owner --uid-owner ratchet-holdout -d fd00:ec2::254 -j REJECT || true
mount -o remount,hidepid=2 /proc >/dev/null 2>&1 || true
command -v docker >/dev/null 2>&1 && systemctl start docker >/dev/null 2>&1 || true
install -D -m 755 -o root -g root /dev/null /usr/local/sbin/ratchet-candidate-exec
cat > /usr/local/sbin/ratchet-candidate-exec <<'RATCHET_CANDIDATE_EXEC_EOF'
#!/bin/bash
set -eu
[ "$(id -un)" = ratchet-bench ] || { echo "ratchet-candidate-exec must run as ratchet-bench" >&2; exit 77; }
: "${RATCHET_CANDIDATE_DIR:?}" "${RATCHET_CANDIDATE_HOME:?}" "${RATCHET_CANDIDATE_TMP:?}" "${RATCHET_CANDIDATE_PATH:?}"
for a in "$@"; do
  case "$a" in
    [A-Za-z_]*=*)
      case "$a" in
        RATCHET_TRACE=*|AWS_*=*) echo "refusing to pass ${a%%=*} to candidate code" >&2; exit 78 ;;
      esac ;;
    *) break ;;
  esac
done
cd "$RATCHET_CANDIDATE_DIR"
exec env -i PATH="$RATCHET_CANDIDATE_PATH" HOME="$RATCHET_CANDIDATE_HOME" TMPDIR="$RATCHET_CANDIDATE_TMP" USER=ratchet-bench LOGNAME=ratchet-bench LANG=C.UTF-8 "$@"
RATCHET_CANDIDATE_EXEC_EOF
install -D -m 755 -o root -g root /dev/null /usr/local/bin/ratchet-candidate
cat > /usr/local/bin/ratchet-candidate <<'RATCHET_CANDIDATE_LAUNCHER_EOF'
#!/bin/sh
exec sudo -n -u ratchet-bench /usr/local/sbin/ratchet-candidate-exec "$@"
RATCHET_CANDIDATE_LAUNCHER_EOF
install -D -m 440 -o root -g root /dev/null /etc/sudoers.d/ratchet-holdout.tmp
cat > /etc/sudoers.d/ratchet-holdout.tmp <<'RATCHET_SUDOERS_EOF'
Defaults:ratchet-holdout !requiretty, !use_pty, !lecture, env_keep += "RATCHET_CANDIDATE_DIR RATCHET_CANDIDATE_HOME RATCHET_CANDIDATE_TMP RATCHET_CANDIDATE_PATH"
ratchet-holdout ALL=(ratchet-bench) NOPASSWD: /usr/local/sbin/ratchet-candidate-exec
RATCHET_SUDOERS_EOF
visudo -cf /etc/sudoers.d/ratchet-holdout.tmp >/dev/null || { rm -f /etc/sudoers.d/ratchet-holdout.tmp; echo "invalid sudoers rule for ratchet-holdout" >&2; exit 1; }
mv /etc/sudoers.d/ratchet-holdout.tmp /etc/sudoers.d/ratchet-holdout
install -d -m 700 /etc/ratchet
umask 077
cat > /etc/ratchet/runner.env <<'RATCHET_ENV_EOF'
RATCHET_OPTIMIZATION_ID='opt1'
RATCHET_BENCH_PURPOSE='confirm'
RATCHET_ENV_EOF
set -a; . /etc/ratchet/runner.env; set +a
mkdir -p /run/ratchet && touch /run/ratchet/user-data.done
