---
source: crates/ratchet-bench/tests/snapshots.rs
expression: "checkout_script(&i).expect(\"script\")"
---
set -uo pipefail
W='/var/tmp/ratchet-bench/opt1-1234'
CODE="$W/code"; STAGE="$W/stage"; G="$W/repo.git"; H="$W/harness"
emit() { printf '%s %s %s\n' '@@RATCHET@@' "$1" "$2"; }
b64() { base64 | tr -d '\n'; }

parents_real() {
  local d acc="$CODE" part; local -a parts
  d=$(dirname -- "$1"); [ "$d" = . ] && return 0
  IFS=/ read -ra parts <<< "$d"
  for part in "${parts[@]}"; do acc="$acc/$part"; [ -L "$acc" ] && return 1; [ -d "$acc" ] || return 1; done
  return 0
}
ensure_parents() {
  local d acc="$CODE" part; local -a parts
  d=$(dirname -- "$1"); [ "$d" = . ] && return 0
  IFS=/ read -ra parts <<< "$d"
  for part in "${parts[@]}"; do
    acc="$acc/$part"
    if [ -L "$acc" ] || { [ -e "$acc" ] && [ ! -d "$acc" ]; }; then rm -f -- "${acc:?}"; fi
    [ -d "$acc" ] || mkdir -- "$acc"
  done
}
same() {
  if [ -L "$1" ]; then [ -L "$2" ] && [ "$(readlink -- "$1")" = "$(readlink -- "$2")" ]
  else [ -f "$2" ] && [ ! -L "$2" ] && cmp -s -- "$1" "$2"; fi
}
copied=0
apply() {
  local mode="$1" p
  : > "$W/changed.list"
  while IFS= read -r -d '' p; do
    if [ "$mode" = check ] && parents_real "$p" && same "$STAGE/$p" "$CODE/$p"; then continue; fi
    [ "$mode" = check ] && printf '%s\0' "$p" >> "$W/changed.list"
    ensure_parents "$p"
    rm -rf -- "${CODE:?}/${p:?}"
    cp -P -p -- "$STAGE/$p" "$CODE/$p" || return 1
    copied=$((copied+1))
  done < "$W/bench.match"
}

RE='(?s)^(?:bench\/.*|pnpm-lock\.yaml|pnpm-workspace\.yaml)(?:/.*)?\z'; RE_USER='(?s)^(?:bench\/.*)(?:/.*)?\z'
rm -rf -- "${W:?}"; mkdir -p "$CODE" "$STAGE" "$W/logs" "$W/in" || exit 10
fetch() {
  aws s3 cp --only-show-errors "$1" "$3" || { echo "cannot download $1" >&2; return 1; }
  [ "$(sha256sum -- "$3" | cut -d' ' -f1)" = "$2" ] || { echo "sha256 mismatch for $1" >&2; return 2; }
}
fetch 's3://ratchet-test-artifacts/bench-inputs/opt1/job1/code.tgz' 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' "$W/in/code.tgz" || exit 20
fetch 's3://ratchet-test-artifacts/bench-inputs/opt1/job1/bench.tgz' 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' "$W/in/bench.tgz" || exit 21
tar -xzf "$W/in/code.tgz" -C "$CODE" --no-same-owner || exit 22
tar -xzf "$W/in/bench.tgz" -C "$STAGE" --no-same-owner || exit 23
list() { (cd -- "$1" && find . -mindepth 1 \( -type f -o -type l \) -printf '%P\0'); }
list "$STAGE" | grep -zP "$RE" > "$W/bench.match" || true
matched=$(list "$STAGE" | grep -zcP "$RE_USER" || true)
list "$CODE" | grep -zP "$RE" > "$W/code.match" || true
removed=0
if [ 1 = 1 ]; then
  CODE_REAL=$(cd "$CODE" && pwd -P)
  while IFS= read -r -d '' p; do
    d=$(dirname -- "$p")
    if [ "$d" = . ] || [ "$(realpath -m -- "$CODE/$d")" = "$CODE_REAL/$d" ]; then
      rm -rf -- "${CODE:?}/${p:?}"
      grep -zqxF -- "$p" "$W/bench.match" || removed=$((removed+1))
    fi
  done < "$W/code.match"
fi
apply init || exit 24
BU='ratchet-bench'; HU='ratchet-holdout'; LAUNCHER='/usr/local/bin/ratchet-candidate'
id -u "$BU" >/dev/null 2>&1 || { echo "bench user $BU does not exist on this image" >&2; exit 12; }
id -u "$HU" >/dev/null 2>&1 || { echo "holdout user $HU does not exist on this image" >&2; exit 12; }
for u in "$BU" "$HU"; do
  iptables -C OUTPUT -m owner --uid-owner "$u" -d 169.254.169.254 -j REJECT >/dev/null 2>&1 || { echo "IMDS is not blocked for $u (iptables owner rule missing)" >&2; exit 13; }
done
if setpriv --reuid="$BU" --regid="$BU" --clear-groups --no-new-privs -- timeout 3 bash -c 'exec 3<>/dev/tcp/169.254.169.254/80' 2>/dev/null; then echo "instance metadata is reachable as $BU" >&2; exit 14; fi
if setpriv --reuid="$HU" --regid="$HU" --clear-groups -- timeout 3 bash -c 'exec 3<>/dev/tcp/169.254.169.254/80' 2>/dev/null; then echo "instance metadata is reachable as $HU" >&2; exit 14; fi
mkdir -p "$W/home" "$W/tmp" "$W/hhome" "$W/htmp" "$W/out" "$W/holdout" || exit 15
chown -R "$BU:" "$CODE" "$W/home" "$W/tmp" || exit 16
chown -R "$HU:" "$W/hhome" "$W/htmp" "$W/out" "$W/holdout" || exit 16
chmod 700 "$W/holdout"
chmod 755 "$W"
export RATCHET_CANDIDATE_DIR="$CODE" RATCHET_CANDIDATE_HOME="$W/home" RATCHET_CANDIDATE_TMP="$W/tmp" RATCHET_CANDIDATE_PATH="$PATH"
printf x > "$W/holdout/.probe" && chown "$HU:" "$W/holdout/.probe" && chmod 600 "$W/holdout/.probe" || exit 15
if setpriv --reuid="$BU" --regid="$BU" --clear-groups --no-new-privs -- cat "$W/holdout/.probe" >/dev/null 2>&1; then echo "the holdout directory is readable by $BU" >&2; exit 17; fi
setpriv --reuid="$HU" --regid="$HU" --clear-groups -- cat "$W/holdout/.probe" >/dev/null 2>&1 || { echo "the holdout directory is not readable by $HU" >&2; exit 19; }
rm -f "$W/holdout/.probe"
# ---- container image (root): loaded offline, verified, probed ----
command -v docker >/dev/null 2>&1 || { echo "docker is missing on this image (rebuild the bench image)" >&2; exit 60; }
for _i in $(seq 1 30); do docker info >/dev/null 2>&1 && break; sleep 2; done
docker info >/dev/null 2>&1 || { echo "the docker daemon is not running" >&2; exit 60; }
docker info --format '{{json .SecurityOptions}}' 2>/dev/null | grep -q seccomp || { echo "the docker daemon runs without its default seccomp profile" >&2; exit 61; }
BUID=$(id -u "$BU"); BGID=$(id -g "$BU"); HUID=$(id -u "$HU"); HGID=$(id -g "$HU")
for u in "$BU" "$HU"; do
  if id -nG "$u" 2>/dev/null | tr ' ' '\n' | grep -qxE 'docker|root|wheel|sudo'; then echo "$u is in a privileged group (docker/root/wheel/sudo): it could reach the docker socket" >&2; exit 66; fi
done
IMG="$W/image"; mkdir -p "$IMG/in" || exit 62
aws s3 cp --only-show-errors 's3://ratchet-test-artifacts/bench-images/img-ffffffffffffffffffffffffffffffffffffffff/dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd.tar.zst' "$IMG/in/image" || { echo "cannot download the container image s3://ratchet-test-artifacts/bench-images/img-ffffffffffffffffffffffffffffffffffffffff/dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd.tar.zst" >&2; exit 62; }
[ "$(sha256sum -- "$IMG/in/image" | cut -d' ' -f1)" = 'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd' ] || { echo "sha256 mismatch for the container image" >&2; exit 63; }
zstd -dc -- "$IMG/in/image" | docker load >"$IMG/load.out" 2>&1 || { tail -c 600 "$IMG/load.out" >&2; echo "docker load failed" >&2; exit 64; }
rm -f "$IMG/in/image"
[ "$(docker image inspect --format '{{.Id}}' 'ratchet-env:img-ffffffffffffffffffffffffffffffffffffffff' 2>/dev/null)" = 'sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee' ] || { echo "the loaded image is not sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee (tag ratchet-env:img-ffffffffffffffffffffffffffffffffffffffff)" >&2; exit 65; }
ctr() { docker run --rm --pull never --network none --cap-drop ALL --security-opt no-new-privileges --read-only --user "$BUID:$BGID" --entrypoint sh 'ratchet-env:img-ffffffffffffffffffffffffffffffffffffffff' -c "$1"; }
CN="ratchet-$(basename -- "$W")-probe"
[ -x '/usr/local/libexec/ratchet/ratchet-candidate-ctr' ] && [ -u '/usr/local/libexec/ratchet/ratchet-candidate-ctr' ] && [ "$(stat -c %u '/usr/local/libexec/ratchet/ratchet-candidate-ctr')" = 0 ] || { echo "the candidate launcher /usr/local/libexec/ratchet/ratchet-candidate-ctr is missing or is not a setuid root file (rebuild the bench image)" >&2; exit 69; }
printf '%s %s %s\n' "$HUID" "$BUID" "$BGID" > "$W/launcher.conf" && chown root:root "$W/launcher.conf" 2>/dev/null; chmod 644 "$W/launcher.conf" || exit 69
printf x > "$W/holdout/.cprobe" && chown "$HU:" "$W/holdout/.cprobe" && chmod 600 "$W/holdout/.cprobe" || exit 67
docker rm -f "$CN" >/dev/null 2>&1 || true
pr=$(docker run --rm --name "$CN" --pull never --init --network none --cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp:rw,exec,nosuid,nodev,size=2g --pids-limit 4096 --user "$BUID:$BGID" --workdir / --entrypoint sh 'ratchet-env:img-ffffffffffffffffffffffffffffffffffffffff' -c 'if command -v bash >/dev/null 2>&1; then exec bash -c "$1"; else exec sh -c "$1"; fi' ratchet-step "EXPECT_UID=$BUID;"'[ "$(id -u)" = "$EXPECT_UID" ] || { echo "runs as uid $(id -u), expected $EXPECT_UID"; exit 1; }
{ [ ! -e /var/run/docker.sock ] && [ ! -e /run/docker.sock ]; } || { echo "a docker socket is visible"; exit 1; }
grep -Eq '\''^CapEff:[[:space:]]*0+$'\'' /proc/self/status || { echo "capabilities are not dropped"; exit 1; }
grep -Eq '\''^NoNewPrivs:[[:space:]]*1'\'' /proc/self/status || { echo "no_new_privs is not set"; exit 1; }
n=$(ls /sys/class/net 2>/dev/null | tr '\''\n'\'' '\'' '\''); [ "$n" = "lo " ] || [ -z "$n" ] || { echo "network interfaces visible: $n"; exit 1; }
echo ok' 2>&1) || { echo "container probe failed: $pr" >&2; exit 67; }
pr=$(docker run --rm --name "$CN" --pull never --init --network none --cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp:rw,exec,nosuid,nodev,size=2g --pids-limit 4096 --user "$BUID:$BGID" --workdir / --entrypoint sh 'ratchet-env:img-ffffffffffffffffffffffffffffffffffffffff' -c 'if command -v bash >/dev/null 2>&1; then exec bash -c "$1"; else exec sh -c "$1"; fi' ratchet-step "EXPECT_UID=$BUID;"'touch /ratchet-rootfs-probe 2>/dev/null && { echo "the root filesystem is writable"; exit 1; }; echo ok' 2>&1) || { echo "container probe failed: $pr" >&2; exit 67; }
docker rm -f "$CN" >/dev/null 2>&1 || true
pr=$(docker run --rm --name "$CN" --pull never --init --network none --cap-drop ALL --cap-add SETUID --cap-add SETGID --read-only --tmpfs /tmp:rw,exec,nosuid,nodev,size=2g --pids-limit 4096 --user "$HUID:$HGID" --workdir / -v "$W/holdout:$W/holdout:ro" -v "/usr/local/libexec/ratchet/ratchet-candidate-ctr:/ratchet/candidate:ro" -v "$W/launcher.conf:/ratchet/launcher.conf:ro" -e "RATCHET_CANDIDATE_DIR=/" -e "RATCHET_CANDIDATE_HOME=/tmp" -e "RATCHET_CANDIDATE_TMP=/tmp" --entrypoint sh 'ratchet-env:img-ffffffffffffffffffffffffffffffffffffffff' -c 'if command -v bash >/dev/null 2>&1; then exec bash -c "$1"; else exec sh -c "$1"; fi' ratchet-step "HARNESS_UID=$HUID; EXPECT_UID=$BUID; PROBE_FILE=$W/holdout/.cprobe;"'[ "$(id -u)" = "$HARNESS_UID" ] || { echo "harness runs as uid $(id -u), expected $HARNESS_UID"; exit 1; }
cat "$PROBE_FILE" >/dev/null 2>&1 || { echo "the harness cannot read the holdout directory"; exit 1; }
out=$(/ratchet/candidate sh -c '\''id -u; grep -E "^NoNewPrivs" /proc/self/status; if cat "$1" >/dev/null 2>&1; then echo LEAK; fi'\'' x "$PROBE_FILE" 2>&1) || { echo "the launcher failed: $out"; exit 1; }
[ "$(printf '\''%s\n'\'' "$out" | sed -n 1p)" = "$EXPECT_UID" ] || { echo "the launcher did not run the candidate as uid $EXPECT_UID: $out"; exit 1; }
printf '\''%s\n'\'' "$out" | grep -Eq '\''NoNewPrivs:[[:space:]]*1'\'' || { echo "candidate processes have no no_new_privs"; exit 1; }
printf '\''%s\n'\'' "$out" | grep -q LEAK && { echo "a candidate process can read the holdout"; exit 1; }
echo ok' 2>&1) || { echo "harness container probe failed: $pr" >&2; rm -f "$W/holdout/.cprobe"; exit 68; }
rm -f "$W/holdout/.cprobe"
emit container "{\"tag\":\"ratchet-env:img-ffffffffffffffffffffffffffffffffffffffff\",\"imageId\":\"sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\",\"readOnlyRoot\":true,\"network\":\"none\"}"
# ---- dependency snapshot (root): read-only for the candidate user ----
D="$W/deps"; STORE="$D/store"; SCRATCH="$W/home/.ratchet-deps"
mkdir -p "$STORE" "$D/in" "$SCRATCH" || exit 25
aws s3 cp --only-show-errors 's3://ratchet-test-artifacts/bench-deps/pnpm-ffffffffffffffffffffffffffffffffffffffff/dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd.tar.zst' "$D/in/snapshot" || { echo "cannot download the dependency snapshot s3://ratchet-test-artifacts/bench-deps/pnpm-ffffffffffffffffffffffffffffffffffffffff/dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd.tar.zst" >&2; exit 25; }
[ "$(sha256sum -- "$D/in/snapshot" | cut -d' ' -f1)" = 'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd' ] || { echo "sha256 mismatch for the dependency snapshot" >&2; exit 26; }
[ "$(ctr 'node --version' 2>/dev/null)" = 'v22.22.0' ] || { echo "the dependency snapshot was built with node v22.22.0, this container has $(ctr 'node --version' 2>&1)" >&2; exit 27; }
[ "$(ctr 'pnpm --version' 2>/dev/null)" = '10.28.0' ] || { echo "the dependency snapshot was built with pnpm 10.28.0, this container has $(ctr 'pnpm --version' 2>&1)" >&2; exit 27; }
command -v zstd >/dev/null 2>&1 || { echo "zstd is missing on this image (rebuild the bench image)" >&2; exit 28; }
zstd -dc -- "$D/in/snapshot" | tar -x -C "$STORE" --no-same-owner --no-same-permissions || exit 29
rm -f "$D/in/snapshot"
if [ -n "$(find "$STORE" -type l -print -quit)" ]; then echo "the dependency snapshot contains symlinks" >&2; exit 29; fi
for v in "$STORE"/v*; do [ -d "$v" ] || continue; rm -rf "$v/projects"; ln -s "$SCRATCH/pnpm-projects" "$v/projects"; done; mkdir -p "$SCRATCH/pnpm-projects"
chown -R "$BU:" "$SCRATCH" || exit 16
chown -hR root:root "$D" || exit 16
chmod -R go-w,a+rX "$D" || exit 16
emit deps "{\"restored\":true,\"bytes\":$(du -sb "$STORE" | cut -f1)}"
emit checkout "{\"code\":\"cccccccccccccccccccccccccccccccccccccccc\",\"bench\":\"cccccccccccccccccccccccccccccccccccccccc\",\"removed\":$removed,\"copied\":$copied,\"matched\":$matched,\"isolation\":\"user\",\"container\":true}"
