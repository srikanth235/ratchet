{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SandboxBucketsOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:ListBucket"
      ],
      "Resource": [
        "${artifacts_bucket_arn}",
        "${artifacts_bucket_arn}/*",
        "${sealed_bucket_arn}",
        "${sealed_bucket_arn}/*"
      ]
    }
  ]
}
