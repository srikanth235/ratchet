{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadHoldoutTraces",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${sealed_bucket_arn}/${sealed_confirm_prefix}*"
    },
    {
      "Sid": "ListHoldoutTraces",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${sealed_bucket_arn}",
      "Condition": { "StringLike": { "s3:prefix": "${sealed_confirm_prefix}*" } }
    },
    {
      "Sid": "ReadBenchInputs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${artifacts_bucket_arn}/bench-inputs/*"
    },
    {
      "Sid": "ReadBenchDeps",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${artifacts_bucket_arn}/bench-deps/*"
    },
    {
      "Sid": "ReadBenchImages",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${artifacts_bucket_arn}/bench-images/*"
    },
    {
      "Sid": "WriteBenchResults",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "${artifacts_bucket_arn}/bench-results/*"
    },
    {
      "Sid": "SsmManagedInstanceChannel",
      "Effect": "Allow",
      "Action": [
        "ssm:UpdateInstanceInformation",
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel",
        "ec2messages:AcknowledgeMessage",
        "ec2messages:DeleteMessage",
        "ec2messages:FailMessage",
        "ec2messages:GetEndpoint",
        "ec2messages:GetMessages",
        "ec2messages:SendReply"
      ],
      "Resource": "*"
    }
  ]
}
