    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/client-ssm": "^3.1160.0",
    "@aws-sdk/client-sts": "^3.1160.0",
    "@ratchet/core": "workspace:*"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0",
    "vitest": "^3.2.7"
  }
