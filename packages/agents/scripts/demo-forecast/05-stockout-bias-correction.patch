+/**
+ * Stockout correction. A week with empty shelves records a fraction of the real demand, which drags every average
+ * down (the forecasts come out biased low). Weeks far below their neighbours are treated as missing and filled in.
+ */
+const mean = (xs: readonly number[]) => xs.reduce((a, b) => a + b, 0) / Math.max(1, xs.length);
+
+/** A week is a stockout when it sells less than this fraction of the median of its neighbours. */
+const STOCKOUT_RATIO = 0.3;
+const NEIGHBOURHOOD = 4;
+
+function median(xs: number[]): number {
+  const s = [...xs].sort((a, b) => a - b);
+  const m = s.length >> 1;
+  return s.length === 0 ? 0 : s.length % 2 ? s[m]! : (s[m - 1]! + s[m]!) / 2;
+}
+
+export function maskStockouts(y: readonly number[]): number[] {
+  const out: number[] = y.slice();
+  const missing = new Array<boolean>(y.length).fill(false);
+  for (let t = 0; t < y.length; t++) {
+    const neighbours: number[] = [];
+    for (let k = -NEIGHBOURHOOD; k <= NEIGHBOURHOOD; k++) if (k !== 0 && y[t + k] !== undefined) neighbours.push(y[t + k]!);
+    if (y[t]! < STOCKOUT_RATIO * median(neighbours)) missing[t] = true;
+  }
+  for (let t = 0; t < y.length; t++) {
+    if (!missing[t]) continue;
+    let a = t - 1;
+    while (a >= 0 && missing[a]) a--;
+    let b = t + 1;
+    while (b < y.length && missing[b]) b++;
+    out[t] = mean([a >= 0 ? out[a]! : undefined, b < y.length ? out[b]! : undefined].filter((v): v is number => v !== undefined));
+  }
+  return out;
+}
