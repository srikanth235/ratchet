          "text": "Mixing a little of the demand already on file for the target weeks into the model should correct its drift without trusting it fully: 30% weight."
        },
        {
          "type": "edit",
          "path": "src/predict.ts",
          "find": "import type { Forecast, SalesTable } from './types.js';",
          "replace": "import type { Forecast, SalesTable } from './types.js';\n\n/** Online correction: pull the forecast towards the demand already on file for the same weeks. */\nexport function onlineCorrection(table: SalesTable, origin: number, forecast: Forecast): Forecast {\n  return forecast.map((row, s) => row.map((v, h) => 0.7 * v + 0.3 * (table.units[s]![origin + h] ?? v)));\n}"
