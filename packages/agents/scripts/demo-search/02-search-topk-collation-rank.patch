+    const heap = this.heap;
+    while (i > 0) {
+      const parent = (i - 1) >> 1;
+      if (this.compare(heap[i] as Match, heap[parent] as Match) <= 0) break;
+      [heap[i], heap[parent]] = [heap[parent] as Match, heap[i] as Match];
+      i = parent;
+    }
+  }
+
+  private down(i: number): void {
+    const heap = this.heap;
+    for (;;) {
+      let worst = i;
+      for (const child of [2 * i + 1, 2 * i + 2]) {
+        if (child < heap.length && this.compare(heap[child] as Match, heap[worst] as Match) > 0) worst = child;
+      }
+      if (worst === i) return;
+      [heap[i], heap[worst]] = [heap[worst] as Match, heap[i] as Match];
+      i = worst;
+    }
+  }
