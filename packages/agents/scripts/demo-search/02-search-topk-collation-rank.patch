+/** Collation rank of every product name (index = catalog position), so ordering needs no localeCompare. */
+const nameRankCache = new WeakMap<Catalog, Int32Array>();
+function nameRanks(catalog: Catalog): Int32Array {
+  let ranks = nameRankCache.get(catalog);
+  if (ranks) return ranks;
+  const names = [...new Set(catalog.products.map((p) => p.name))].sort((a, b) => a.localeCompare(b));
+  const rankOf = new Map<string, number>();
+  let rank = 0;
+  names.forEach((name, i) => {
