+  offer(m: Match): void {
+    const heap = this.heap;
+    if (heap.length < this.k) {
+      heap.push(m);
+      this.up(heap.length - 1);
+    } else if (this.k > 0 && this.compare(m, heap[0] as Match) < 0) {
+      heap[0] = m;
+      this.down(0);
+    }
+  }
