-  for (const [word, postings] of catalog.index) {
-    if (!word.startsWith(term)) continue;
+  const words = sortedWords(catalog);
+  let lo = 0;
+  let hi = words.length;
+  while (lo < hi) {
+    const mid = (lo + hi) >> 1;
+    if ((words[mid] as string) < term) lo = mid + 1;
+    else hi = mid;
+  }
+  for (let i = lo; i < words.length && (words[i] as string).startsWith(term); i++) {
+    const postings = catalog.index.get(words[i] as string) as Postings;
     for (const position of postings.tags) if (!scores.has(position)) scores.set(position, TAG_WEIGHT);
