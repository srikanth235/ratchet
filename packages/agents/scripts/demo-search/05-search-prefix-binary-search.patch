+/** Indexed words in code-unit order, built once per catalog, so prefix lookups can binary-search. */
+const sortedWordsCache = new WeakMap<Catalog, string[]>();
+function sortedWords(catalog: Catalog): string[] {
+  let words = sortedWordsCache.get(catalog);
+  if (!words) sortedWordsCache.set(catalog, (words = [...catalog.index.keys()].sort()));
+  return words;
+}
