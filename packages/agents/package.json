{
  "name": "@ratchet/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ratchet/core": "workspace:*"
  },
  "bin": {
    "ratchet-runner": "dist/bin/ratchet-runner.js"
  }
}
